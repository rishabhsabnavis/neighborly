# Placeholders only. Copy to backend/.env and fill in. Never commit .env.

# Comma-separated deployed frontend origins (localhost is always allowed)
CORS_ORIGINS=

# NVIDIA Nemotron (build.nvidia.com > Get API Key). OpenAI-compatible API.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Agent/planner (tool calls) and high-volume reply triage. Same key for both.
NEMOTRON_AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_TRIAGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Follow-up questions (defaults to the agent model: lightning ignored the question order in tests)
NEMOTRON_FOLLOWUP_MODEL=

# Photon iMessage (app.photon.codes, promo HACKWITHPHOTON > project > Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Voice: Photon number <-> SIP <-> ElevenLabs agent <-> our backend as Custom LLM
# (see docs/CONTEXT.md "Voice plan"). Outbound calls use the ElevenLabs SIP outbound-call API.
PHOTON_VOICE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Public base URL ElevenLabs calls back to (cloudflared tunnel or deployed backend)
PUBLIC_BASE_URL=
ELEVENLABS_PHONE_NUMBER_ID=
# Photon outbound SIP credential (written by `just voice-outbound --setup`; password is shown ONCE by Photon)
PHOTON_SIP_OUT_USERNAME=
PHOTON_SIP_OUT_PASSWORD=
PHOTON_SIP_OUT_ADDRESS=sip.photon.codes:5061
PHOTON_SIP_OUT_TRANSPORT=tls

# Neighborly core. fake / heuristic / rules run the demo with no live keys.
# MESSENGER=fake|photon  CALLER=fake|elevenlabs  BRAIN=heuristic|nemotron  PLANNER=rules|nemotron
MESSENGER=fake
CALLER=fake
BRAIN=heuristic
PLANNER=rules
# E.164 demo handsets. ph_017 reads DEMO_PHONE_A, ph_041 reads DEMO_PHONE_B.
DEMO_PHONE_A=
DEMO_PHONE_B=
# Set to 1 to skip the JOIN opt-in during development.
DEMO_ASSUME_OPTED_IN=
# Public frontend URL for the claim PDF link (`just tunnel`). Blank = confirmation text has no link.
CLAIM_LINK_BASE_URL=
NO_REPLY_SECONDS=60
AGENT_TICK_SECONDS=15
