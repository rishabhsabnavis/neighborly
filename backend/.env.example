# Placeholders only. Copy to backend/.env and fill in. Never commit .env.

# Comma-separated deployed frontend origins (localhost is always allowed)
CORS_ORIGINS=

# NVIDIA Nemotron (build.nvidia.com > Get API Key). OpenAI-compatible API.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Agent/planner (tool calls) and high-volume reply triage. Same key for both.
NEMOTRON_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_TRIAGE_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Photon iMessage (app.photon.codes, promo HACKWITHPHOTON > project > Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Twilio voice for calls to non-responders (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public base URL Twilio calls back to (cloudflared tunnel or deployed backend)
PUBLIC_BASE_URL=
