# Copy to spikes/.env (gitignored) and fill in.

# build.nvidia.com > any Nemotron model > "Get API Key"
NVIDIA_API_KEY=
# optional: force a model id (otherwise the spike picks one)
NEMOTRON_MODEL=

# app.photon.codes (promo code HACKWITHPHOTON) > project > Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
