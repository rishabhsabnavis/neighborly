# Copy to spikes/.env (gitignored) and fill in.

# build.nvidia.com > any Nemotron model > "Get API Key"
NVIDIA_API_KEY=
# optional: force a model id (otherwise the spike picks one)
NEMOTRON_MODEL=

# app.photon.codes (promo code HACKWITHPHOTON) > project > Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# State Farm outbound spikes
# comma-separated numbers to text first (team phones), E.164: +15551234567
OUTBOUND_TO=
# Twilio trial (console.twilio.com). Trial can only call verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CALL_TO=
# public URL from: cloudflared tunnel --url http://localhost:8010
VOICE_WEBHOOK_BASE=
