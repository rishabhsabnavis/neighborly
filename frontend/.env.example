# Backend origin. Rebuilt into the client, so restart `pnpm dev` after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to 1 to render frontend/lib/mock instead of the API.
NEXT_PUBLIC_USE_MOCK=
# Set to 1 in production so browsers reach the API through /backend on this site.
NEXT_PUBLIC_USE_API_PROXY=
